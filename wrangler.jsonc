{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lanchonete-3",
  "main": "worker-admin-app.js",
  "compatibility_date": "2026-08-27",
  "keep_vars": true,
  "vars": {
    "ADMIN_PASSWORD_SHA256": "bfcfc09b0c6942fcc6b279a37c51567b95ade470d4f3f218899c225227435c3b",
    "ROBOT_WEBHOOK_TOKEN_SHA256": "60c4d161dbf54a55d6980fb9e6c57cbf512c1beab5e5d7f81d6c8799515799c6",
    "ROBOT_SERVICE_URL": "https://lanchonete-2-whatsapp-production.up.railway.app/instances/lanchonete-3-whatsapp",
    "FCM_PROJECT_ID": "lanchonete-admin",
    "FCM_ANDROID_API_KEY": "AIzaSyBxBWHnh0y5sExe81CIoQ6cV6czDFIHDGs",
    "FCM_ANDROID_APP_ID": "1:35803389315:android:2d8d6884073057cb05aab6",
    "FCM_SENDER_ID": "35803389315",
    "SITE_STYLE_VARIANT": "artisan",
    "SITE_DEFAULT_NAME": "Lanchonete 3",
    "SITE_DEFAULT_SUBTITLE": "Cardápio da casa",
    "SITE_DEFAULT_HERO_TITLE": "Comida boa.\nPedido simples.",
    "SITE_DEFAULT_HERO_TEXT": "Veja o cardápio, escolha seus itens e envie o pedido direto para a nossa equipe.",
    "SITE_DEFAULT_PRIMARY": "#5b1830",
    "SITE_DEFAULT_ACCENT": "#d8a94d",
    "SITE_DEFAULT_BACKGROUND": "#f7f0e7",
