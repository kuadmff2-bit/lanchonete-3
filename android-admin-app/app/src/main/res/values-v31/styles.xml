<resources>
    <style name="Theme.LanchoneteAdmin" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#F7F0E7</item>
        <item name="android:statusBarColor">#5B1830</item>
        <item name="android:navigationBarColor">#F7F0E7</item>
        <item name="android:colorAccent">#5B1830</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Android 12+: o splash do sistema fica neutro e some rápido; a SplashView nativa mostra o CV. -->
        <item name="android:windowSplashScreenBackground">#F7F0E7</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#F7F0E7</item>
        <item name="android:windowSplashScreenAnimationDuration">50</item>
    </style>
</resources>
